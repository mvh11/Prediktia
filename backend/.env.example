# Copia este archivo como .env y pega tu clave real de https://www.api-football.com/
API_FOOTBALL_KEY=tu_clave_aqui

# URL base oficial de API-Football v3 (normalmente no hace falta cambiarla)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Opcional: timeouts (s) connect y read hacia API-Football
# API_FOOTBALL_TIMEOUT_CONNECT_SECONDS=10
# API_FOOTBALL_TIMEOUT_READ_SECONDS=25

# Opcional: TTL (s) de caché en memoria por fecha; 0 = sin caché (producción recomendable si quieres datos siempre frescos)
# MATCHES_UPSTREAM_CACHE_TTL_SECONDS=90
