# =============================================================================
# Copia este archivo a .env en la misma carpeta (backend/) y ajusta valores.
# =============================================================================

# --- API-Football (obligatorio) ---
API_FOOTBALL_KEY=tu_clave_aqui
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Opcional: timeouts (s) connect y read hacia API-Football
# API_FOOTBALL_TIMEOUT_CONNECT_SECONDS=10
# API_FOOTBALL_TIMEOUT_READ_SECONDS=25

# TTL (s) caché fixtures/odds compartida (mínimo efectivo 300). Plan gratuito API-Football.
# MATCHES_UPSTREAM_CACHE_TTL_SECONDS=300

# --- PostgreSQL (producción: Neon; desarrollo local: Docker opcional) ---
# Neon/Render suelen entregar postgresql://…?sslmode=require (se normaliza a +psycopg2).
# DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
# Local (docker compose opcional):
# DATABASE_URL=postgresql+psycopg2://prediktia:password@localhost:5432/prediktia_db

# Si omites DATABASE_URL, la API arranca sin persistencia de historial ACCA.
# Login/registro requieren DATABASE_URL activa.

# --- JWT (login) ---
# JWT_SECRET=genera_un_secreto_largo_y_aleatorio
# JWT_EXPIRE_MINUTES=10080

# --- ACCA ---
# Margen (minutos, UTC) antes del kickoff; 0 = desactivado (recomendado hasta estabilizar filtro)
# ACCA_MIN_MINUTES_BEFORE_KICKOFF=0
